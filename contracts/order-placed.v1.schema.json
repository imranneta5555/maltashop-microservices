{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imranneta5555/maltashop-microservices/contracts/order-placed.v1.schema.json",
  "title": "OrderPlaced v1",
  "description": "Published by order-service when an order is accepted. Consumer: notification-service. The fields listed as required are the ones the consumer relies on; the provider may add fields, but removing or renaming one is a breaking change and needs a v2.",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "occurred_at", "correlation_id", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "OrderPlaced" },
    "event_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "required": ["order_id", "customer_id", "status", "total_amount", "currency", "items"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "minLength": 1 },
        "status": { "const": "PENDING" },
        "total_amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "properties": {
              "sku": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}

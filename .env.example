# Copy to .env to override the defaults in docker-compose.yml. Never commit a real .env.
ORDER_DB_PASSWORD=order_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password
RABBITMQ_USER=maltashop
RABBITMQ_PASSWORD=maltashop_dev_password
LOG_LEVEL=INFO

# Used by CI to run the images it has just built instead of building new ones.
IMAGE_REGISTRY=local
IMAGE_TAG=dev
